# Export these variables in the API and worker environments; no .env loader is implicit.
VOCARD_DB_PATH=state/ingestion.sqlite3
VOCARD_S3_BUCKET=your-private-book-bucket
AWS_DEFAULT_REGION=ap-northeast-2
# Use the AWS credential chain / a service IAM role. Do not commit credentials.
# Shared only by the API and your trusted JWT issuer; at least 32 random bytes.
VOCARD_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
VOCARD_JWT_ISSUER=vocard-admin
VOCARD_JWT_AUDIENCE=vocard-ingestion
OPENAI_API_KEY=
VOCARD_EMBEDDING_MODEL=text-embedding-3-small
VOCARD_EMBEDDING_DIMENSIONS=1536
VOCARD_CHUNK_SIZE=1000
VOCARD_CHUNK_OVERLAP=150
VOCARD_PIPELINE_REVISION=1
VOCARD_LEASE_SECONDS=120
VOCARD_MAX_ATTEMPTS=3
VOCARD_MAX_UPLOAD_BYTES=104857600
VOCARD_MAX_PAGES=2000
VOCARD_MAX_CHUNKS=30000
# CLI only: administrator JWT from your trusted issuer. Never log or commit it.
VOCARD_ADMIN_TOKEN=
VOCARD_API_URL=http://127.0.0.1:8000
